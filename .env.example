# LitLens AI & Database Configuration Template
# Copy this file to .env and set your free NVIDIA NIM or Gemini API key

# AI Provider Configuration (nvidia | gemini | ollama | auto | fallback)
AI_PROVIDER=nvidia

# NVIDIA NIM Low-Latency Free Models (Get free API key at https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Optional: Google Gemini API Key
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Optional: Ollama Local LLM Base URL
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Optional: Supabase PostgreSQL Database URL
# DATABASE_URL=postgresql://user:pass@db.xxx.supabase.co:5432/postgres
